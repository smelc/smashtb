# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Single-page app to review, approve and dismiss GitHub pull requests"
description:
  "smashtb takes a list of GitHub pull request links and shows, for each one, the files it modifies, a diff view of every file, and buttons to approve or dismiss the pull request."
maintainer: ["smelc@users.noreply.github.com"]
authors: ["Clement Hurlin"]
license: "MIT"
homepage: "https://github.com/smelc/smashtb"
bug-reports: "https://github.com/smelc/smashtb/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.16" & >= "3.16"}
  "brr" {>= "0.0.6"}
  "js_of_ocaml-compiler" {>= "5.8"}
  "ocamlformat" {with-test & = "0.29.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/smelc/smashtb.git"
